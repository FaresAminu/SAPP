git add DESCRIPTION
# --- GENERATE ALL SAPP PLOTS FOR YOUR PAPER ---
# Load packages
library(SAPP)
library(ggplot2)
library(MASS)
# Set seed for reproducibility
set.seed(123)
# ------------------------------------------------------------
# FIGURE 1: Iris Dataset
# ------------------------------------------------------------
data(iris)
X_iris <- iris[, 1:4]
model_iris <- lm(Petal.Width ~ Sepal.Length + Sepal.Width + Petal.Length, data = iris)
imp_iris <- abs(coef(model_iris)[-1])
names(imp_iris) <- c("Sepal.Length", "Sepal.Width", "Petal.Length")
inf_iris <- influence_feature(X_iris, model_iris)
p1 <- plot_sapp(X_iris, imp_iris, inf_iris, alpha = "auto") +
ggtitle("Iris: Feature Dominance Map")
ggsave("iris_plot.pdf", p1, width = 8, height = 6, dpi = 300)
# ------------------------------------------------------------
# FIGURE 2: mtcars Dataset
# ------------------------------------------------------------
data(mtcars)
X_mtcars <- mtcars[, c("disp", "hp", "wt", "qsec")]
model_mtcars <- lm(mpg ~ disp + hp + wt + qsec, data = mtcars)
imp_mtcars <- abs(coef(model_mtcars)[-1])
inf_mtcars <- influence_feature(X_mtcars, model_mtcars)
p2 <- plot_sapp(X_mtcars, imp_mtcars, inf_mtcars, alpha = "auto") +
ggtitle("mtcars: Weight vs Quarter-Mile Time")
ggsave("mtcars_plot.pdf", p2, width = 8, height = 6, dpi = 300)
# ------------------------------------------------------------
# FIGURE 3: Boston Housing Dataset
# ------------------------------------------------------------
data(Boston, package = "MASS")
X_boston <- Boston[, c("rm", "age", "dis", "tax", "ptratio")]
model_boston <- lm(medv ~ rm + age + dis + tax + ptratio, data = Boston)
imp_boston <- abs(coef(model_boston)[-1])
inf_boston <- influence_feature(X_boston, model_boston)
p3 <- plot_sapp(X_boston, imp_boston, inf_boston, alpha = "auto") +
ggtitle("Boston Housing: Rooms Dominate")
ggsave("boston_plot.pdf", p3, width = 8, height = 6, dpi = 300)
# ------------------------------------------------------------
# FIGURE 4: Diamonds Dataset
# ------------------------------------------------------------
data(diamonds)
diamonds_sub <- diamonds[sample(nrow(diamonds), 500), ]
X_diam <- diamonds_sub[, c("carat", "depth", "table", "x", "y", "z")]
model_diam <- lm(price ~ carat + depth + table + x + y + z, data = diamonds_sub)
imp_diam <- abs(coef(model_diam)[-1])
inf_diam <- influence_feature(X_diam, model_diam)
p4 <- plot_sapp(X_diam, imp_diam, inf_diam, alpha = "auto") +
ggtitle("Diamonds: Carat Dominance")
ggsave("diamonds_plot.pdf", p4, width = 8, height = 6, dpi = 300)
# ------------------------------------------------------------
# FIGURE 5: Palmer Penguins Dataset
# ------------------------------------------------------------
if (!require(palmerpenguins)) install.packages("palmerpenguins")
library(palmerpenguins)
penguins_clean <- na.omit(penguins[, c("bill_length_mm", "bill_depth_mm",
"flipper_length_mm", "body_mass_g", "species")])
X_peng <- penguins_clean[, 1:4]
if (!require(randomForest)) install.packages("randomForest")
library(randomForest)
rf_peng <- randomForest(species ~ ., data = penguins_clean, importance = TRUE)
imp_peng <- importance(rf_peng)[, "MeanDecreaseGini"]
names(imp_peng) <- colnames(X_peng)
inf_peng <- influence_feature(X_peng, rf_peng)
p5 <- plot_sapp(X_peng, imp_peng, inf_peng, alpha = "auto") +
ggtitle("Penguins: Bill vs Flipper")
ggsave("penguins_plot.pdf", p5, width = 8, height = 6, dpi = 300)
# ------------------------------------------------------------
# Confirmation
# ------------------------------------------------------------
cat("✅ All plots saved as PDFs in your working directory:\n")
cat("  - iris_plot.pdf\n")
cat("  - mtcars_plot.pdf\n")
cat("  - boston_plot.pdf\n")
cat("  - diamonds_plot.pdf\n")
cat("  - penguins_plot.pdf\n")
cat("\nNow upload these files to Overleaf!\n")
